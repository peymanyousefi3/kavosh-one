# Local development only. Set production values in the deployment secret store.
APP_ORIGIN=http://localhost:3000
# Runtime connection MUST use kavosh_runtime, never the migration/table owner.
DATABASE_URL=postgresql://kavosh_runtime:REPLACE_ME@localhost:5432/kavosh
# Used only by the explicit migration/bootstrap CLI, never by the web application.
MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE_ME@localhost:5432/kavosh
DATABASE_SSL_MODE=require
# Only set to disable for a local database without TLS. Production rejects disable.

# Separate non-owner login with kavosh_identity membership, NOT kavosh_runtime.
IDENTITY_DATABASE_URL=postgresql://identity_login:REPLACE_ME@localhost:5432/kavosh
# Generate independent high-entropy secrets; no defaults. Keep stable and backed up.
AUTH_SECRET=
# Production proxy must overwrite client IP and inject this secret. Block direct app access.
EDGE_AUTH_SECRET=
# Worker-only environment, never migration credentials. Member of kavosh_delivery only.
DELIVERY_DATABASE_URL=postgresql://delivery_login:REPLACE_ME@localhost:5432/kavosh
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Template only: separate web, worker and operator environments in production.

# Off until private quarantine bucket, credentials, browser CORS and deployment
# controls have been verified. These are secret operator settings, not request data.
R2_UPLOAD_LINKS_ENABLED=false
# JSON array: [{"academyId":"UUID","configuration":{"accountId":"...","jurisdiction":"default or eu","bucket":"...","accessKeyId":"...","secretAccessKey":"...","maximumUploadBytes":67108864}}]
R2_UPLOAD_CONNECTIONS=[]
