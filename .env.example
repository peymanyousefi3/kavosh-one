# Local development only. Set production values in the deployment secret store.
APP_ORIGIN=http://localhost:3000
# Runtime connection MUST use kavosh_runtime, never the migration/table owner.
DATABASE_URL=postgresql://kavosh_runtime:REPLACE_ME@localhost:5432/kavosh
# Used only by the explicit migration/bootstrap CLI, never by the web application.
MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE_ME@localhost:5432/kavosh
DATABASE_SSL_MODE=require
# Only set to disable for a local database without TLS. Production rejects disable.

# Separate non-owner login with kavosh_identity membership, NOT kavosh_runtime.
IDENTITY_DATABASE_URL=postgresql://identity_login:REPLACE_ME@localhost:5432/kavosh
# Generate independent high-entropy secrets; no defaults. Keep stable and backed up.
AUTH_SECRET=
# Optional private bot-key handoff only:independent random32-byte base64url key.
# Keep in the secret store,not client bundles,workers,logs or this file.
# Rotation prevents re-retrieving older derived keys;it does not revoke them.
# Use reviewed credential rotation/revocation to stop those keys explicitly.
# BOT_CREDENTIAL_HANDOFF_SECRET=
# Production proxy must overwrite client IP and inject this secret. Block direct app access.
EDGE_AUTH_SECRET=
# Worker-only environment, never migration credentials. Member of kavosh_delivery only.
DELIVERY_DATABASE_URL=postgresql://delivery_login:REPLACE_ME@localhost:5432/kavosh
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Template only: separate web, worker and operator environments in production.

# Off until private quarantine bucket, credentials, browser CORS and deployment
# controls have been verified. These are secret operator settings, not request data.
R2_UPLOAD_LINKS_ENABLED=false
# JSON array: [{"academyId":"UUID","configuration":{"accountId":"...","jurisdiction":"default or eu","bucket":"...","accessKeyId":"...","secretAccessKey":"...","maximumUploadBytes":67108864}}]
R2_UPLOAD_CONNECTIONS=[]

# Independently reviewed private serving policy AND this operator gate are both
# required. Separate clean-bucket READ-ONLY credentials,never quarantine keys.
# Actual cloud IAM/browser CORS/scanner runtime still need live verification.
R2_DOWNLOAD_LINKS_ENABLED=false
# [{"academyId":"UUID","targetId":"64-lowercase-hex-target-hash","configuration":{"accountId":"...","jurisdiction":"default or eu","bucket":"...","accessKeyId":"...","secretAccessKey":"...","maximumUploadBytes":33554432}}]
R2_DOWNLOAD_CONNECTIONS=[]

# FILE WORKER TEMPLATE ONLY: copy this section into a separate process environment.
# Never pass web/operator/identity/delivery database URLs or auth secrets to it.
# This defaults off and is not included in the web container or auto-started.
FILE_INSPECTION_WORKER_ENABLED=false
# Separate non-owner login with ONLY kavosh_file_worker membership.
FILE_INSPECTION_DATABASE_URL=postgresql://file_worker_login:REPLACE_ME@localhost:5432/kavosh
# Same per-academy target format as R2_UPLOAD_CONNECTIONS, but read-only object
# credentials; only explicitly listed academies may be claimed. No public bucket.
FILE_INSPECTION_R2_CONNECTIONS=[]
# Private Unix socket to a separately configured ClamAV daemon. An independent
# engine/signature/configuration check is still required before production use.
CLAMD_SOCKET_PATH=/run/clamav/clamd.ctl
# REQUIRED when the worker is enabled: set the actual daemon's IANA time zone.
# VERSION uses local ctime without a zone; do not infer it from the academy/host.
# Deliberately invalid placeholder prevents silently assuming UTC.
CLAMD_TIME_ZONE=REPLACE_WITH_DAEMON_TIME_ZONE
CLAMD_MAXIMUM_DATABASE_AGE_SECONDS=172800
FILE_INSPECTION_MAXIMUM_BYTES=67108864
FILE_INSPECTION_TIMEOUT_MS=120000
# Optional preserving unsigned-source PDF screen. Requires the independently
# verified credential-free PDF service and a read-only shared socket directory.
# This is not signed-artifact verification,clean promotion or download approval.
FILE_PDF_VALIDATION_ENABLED=false
FILE_PDF_VALIDATION_SOCKET_PATH=/run/kavosh-pdf/validator.sock

# Public provider callback stays off until the independent ingest login, registry,
# provider webhook and reverse-proxy body/rate/time limits are verified.
BOLDSIGN_WEBHOOK_ENABLED=false
# Endpoint: /api/webhooks/boldsign/CONNECTION_UUID . Keys are endpoint-specific.
# [{"connectionId":"UUID","academyId":"UUID","region":"CA","environment":"Test","clientId":null,"secrets":["<provider-issued signing secret>"]}]
# The placeholder is deliberately invalid; replace it with the actual provider key.
# clientId is explicit: null for an account-level webhook, UUID for an app webhook.
BOLDSIGN_WEBHOOK_CONNECTIONS=[]
# Separate non-owner login with ONLY kavosh_signature_ingest membership.
# No identity/business/file access or direct inbox-table access.
SIGNATURE_INGEST_DATABASE_URL=postgresql://signature_ingest_login:REPLACE_ME@localhost:5432/kavosh

# OPERATIONAL MESSAGE TRANSPORT TEMPLATE ONLY: isolated outbound worker.
# These settings alone NEVER start delivery. Both enable flags and the isolated
# outbound process are required. Live provider/callback/unsubscribe validation
# is NOT proven;do not treat this as production/compliance certification.
# Never borrow authentication provider credentials. At least one of smtp/twilio
# per school,independently optional;no arbitrary provider URL or TLS bypass.
# [{"academyId":"UUID","configuration":{"smtp":{"host":"smtp.example.test","port":465,"user":"REPLACE_ME","password":"REPLACE_ME","from":"sender@example.test"}}}]
OPERATIONAL_DELIVERY_ENABLED=false
OPERATIONAL_DELIVERY_CONNECTIONS=[]
NOTIFICATION_OUTBOUND_WORKER_ENABLED=false
# Separate login with ONLY kavosh_message_worker membership;not a migration,
# identity,web,reminder/report or platform-owner login. No auth/vault secrets.
NOTIFICATION_OUTBOUND_DATABASE_URL=postgresql://message_worker_login:REPLACE_ME@localhost:5432/kavosh
NOTIFICATION_OUTBOUND_ACADEMIES=[]

# NOTIFICATION WORKER TEMPLATE ONLY: separate process/environment; defaults off.
# Do not pass web, operator, identity, email/SMS or file-worker credentials.
# Login must belong to kavosh_automation_worker only (which inherits runtime).
NOTIFICATION_WORKER_ENABLED=false
# Separately opt in to approved persistent rule watchers and configured session reminders (schema128+).
# Existing human-session/bot authority is rechecked; no external email/SMS delivery.
NOTIFICATION_SUBSCRIPTIONS_ENABLED=false
NOTIFICATION_WORKER_DATABASE_URL=postgresql://notification_worker_login:REPLACE_ME@localhost:5432/kavosh
# Explicit academy UUID allowlist; queued requests,mandatory account-contact
# observations and optional approved watchers. No external email/SMS delivery.
NOTIFICATION_WORKER_ACADEMIES=[]
# REPORT WORKER TEMPLATE ONLY: separate process/environment; defaults off.
# A separate non-owner login belongs only to kavosh_automation_worker.
# Never share web/identity/provider credentials or run reports inside the reminder daemon.
REPORT_WORKER_ENABLED=false
# Optional recurring configuration executor,also off by default. Requires the
# report worker and academy allowlist;it queues CSVs,never email/SMS delivery.
REPORT_SCHEDULER_ENABLED=false
REPORT_WORKER_DATABASE_URL=postgresql://report_worker_login:REPLACE_ME@localhost:5432/kavosh
REPORT_WORKER_ACADEMIES=[]
# Operator-only registration: pnpm signatures:register CONNECTION_UUID --enable
# Use MIGRATION_DATABASE_URL only in the separate operator process, never web.
# Optional platform directory: separate non-owner login belongs ONLY to
# kavosh_platform_service. Never grant it to web,identity,bot or worker roles.
PLATFORM_ENABLED=false
PLATFORM_DATABASE_URL=postgresql://platform_login:REPLACE_ME@localhost:5432/kavosh
# Operator-only registration uses PLATFORM_OWNER_USER_ID and PLATFORM_OWNER_REASON
# with MIGRATION_DATABASE_URL in a separate process. Never place those here.
# Optional encrypted Canadian personal-payroll identities: server-only secrets.
# Leave unset until configured in a secret manager; identity writes/reveals fail
# closed,while unrelated routes and metadata remain available. Never reuse auth,
# database or provider keys. Each key is independently random32bytes,base64url.
# PAYROLL_PRIVATE_ACTIVE_KEY_ID=current
# PAYROLL_PRIVATE_KEYS={"current":"REPLACE_WITH_SEPARATE_SECRET_MANAGER_VALUE"}
# PAYROLL_PRIVATE_FINGERPRINT_KEY=REPLACE_WITH_ANOTHER_INDEPENDENT_KEY

# Optional encrypted allergy/care records. Separate managed keys;no payroll fallback.
# Same base64url32-byte key format and retained-key rotation policy as payroll.
# STUDENT_CARE_PRIVATE_ACTIVE_KEY_ID=current
# STUDENT_CARE_PRIVATE_KEYS={"current":"REPLACE_WITH_SEPARATE_SECRET_MANAGER_VALUE"}
# STUDENT_CARE_PRIVATE_FINGERPRINT_KEY=REPLACE_WITH_ANOTHER_INDEPENDENT_KEY
# AES rotation: keep old key labels/material to read retained editions;restart
# the server after a controlled keyring change. Do not change the fingerprint
# key independently:existing commitments depend on it. Back up keys separately
# from database backups;loss makes protected records unrecoverable. No keys in
# browser variables,source control,ordinary logs,report workers or notifications.
