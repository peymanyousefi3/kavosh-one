FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@11.25.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY workers/image-service/package.json ./workers/image-service/package.json
COPY workers/notification-worker/package.json ./workers/notification-worker/package.json
COPY workers/message-worker/package.json ./workers/message-worker/package.json
RUN pnpm install --frozen-lockfile
COPY src ./src
COPY scripts/process-notifications.ts ./scripts/process-notifications.ts
RUN pnpm notifications:build
RUN pnpm --filter @kavosh/notification-worker deploy --prod /runtime

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production TZ=UTC
COPY --from=build --chown=node:node /runtime/package.json ./package.json
COPY --from=build --chown=node:node /runtime/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.notification-worker/src ./src
COPY --from=build --chown=node:node /app/.notification-worker/scripts ./scripts
USER node
CMD ["node", "scripts/process-notifications.js"]
