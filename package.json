{
  "name": "kavosh-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:http": "node tests/http-smoke.mjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts",
    "auth:invite": "node --import tsx scripts/invite.ts",
    "auth:deliver": "node --import tsx scripts/deliver-auth.ts",
    "api:generate": "node --import tsx scripts/generate-api.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "better-auth": "1.7.15",
    "kysely": "0.29.8",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/autocannon": "7.12.7",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "autocannon": "8.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
