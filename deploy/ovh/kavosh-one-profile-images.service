[Unit]
Description=Kavosh One isolated reviewed image-copy worker
After=network-online.target postgresql@18-main.service kavosh-one-parser@image.service
Requires=postgresql@18-main.service kavosh-one-parser@image.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=kavosh-one-profile-images
Group=kavosh-one-profile-images
SupplementaryGroups=kavosh-one-parser-clients
WorkingDirectory=/srv/kavosh-one/operations/profile-images-v1
EnvironmentFile=/etc/kavosh-one/profile-images.env
ExecStart=/usr/bin/node scripts/process-profile-images.js
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryMax=256M
CPUQuota=25%
TasksMax=64
LimitNOFILE=1024
Nice=10

[Install]
WantedBy=multi-user.target
