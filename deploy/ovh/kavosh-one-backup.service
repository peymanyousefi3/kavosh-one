[Unit]
Description=Kavosh One encrypted database and private Drive backup
After=network-online.target postgresql@18-main.service
Wants=network-online.target
Requires=postgresql@18-main.service

[Service]
Type=oneshot
User=kavosh-one-backup
Group=kavosh-one-backup
WorkingDirectory=/srv/kavosh-one/current
EnvironmentFile=/etc/kavosh-one/backup.env
LoadCredential=drive.json:/etc/kavosh-one/drive.json
StateDirectory=kavosh-one-backups
StateDirectoryMode=0700
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /var/lib/kavosh-one-backups/backup.lock /usr/bin/node /srv/kavosh-one/deploy/run-backup.mjs
TimeoutStartSec=20min
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
InaccessiblePaths=/etc/kavosh-one
MemoryHigh=256M
MemoryMax=512M
CPUQuota=50%
Nice=15
IOSchedulingClass=idle
IOWeight=10
TasksMax=64
StandardOutput=journal
StandardError=journal
